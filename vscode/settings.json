{
  "window.zoomLevel": 1,
  "editor.fontLigatures": true,
  "files.autoSave": "afterDelay",
  "telemetry.enableTelemetry": false,
  "editor.quickSuggestionsDelay": 500,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [80, 120],
  "editor.minimap.showSlider": "always",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "editor.fontSize": 14,
  "playwright.reuseBrowser": true,
  "window.commandCenter": true,
  "workbench.colorTheme": "Darcula",
  "editor.fontFamily": "Jetbrains Mono",
  "aws.telemetry": false,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",

  // "mochaExplorer.files": "modules/apps/backend/report/test/**/*.ts",
  // Use this one for joiin
  "mochaExplorer.files": "modules/apps/backend/**/test/**/*.ts",

  // Use this one for typescript-knowledgebase sandbox
  // "mochaExplorer.files": "test/**/*.ts",

  "mochaExplorer.require": ["ts-node/register", "tsconfig-paths/register"],

  // See https://github.com/hbenl/vscode-mocha-test-adapter/issues/206
  "mochaExplorer.nodeArgv": [
    "--loader=ts-node/esm",
    "--no-warnings=ExperimentalWarning",
    "--experimental-specifier-resolution=node",
  ],

  "mochaExplorer.timeout": 2000,

  "explorer.confirmDragAndDrop": false,
  // "angularKarmaTestExplorer.debugMode": true,
  // "angularKarmaTestExplorer.projectRootPath": "modules/apps/frontend",
  // "angularKarmaTestExplorer.angularProcessCommand": "/Users/martinrist/.nvm/versions/node/v18.20.7/bin/ng test --source-map=false",
  "karmaTestExplorer.logLevel": "debug",
  "karmaTestExplorer.enableExtension": true,
  "karmaTestExplorer.projectWorkspaces": [
    "modules/apps/frontend",
    "books/learning-angular-4e/06-services-and-di",
    ".",
  ],
  "karmaTestExplorer.karmaLogLevel": "debug",
  "karmaTestExplorer.debuggerConfig": {
    "name": "Karma Test Explorer Debugging",
    "type": "chrome",
    "request": "attach",
    "browserAttachLocation": "workspace",
    "address": "localhost",
    "port": 9222,
    "timeout": 60000,
  },
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "[typescript]": {},
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "mochaExplorer.logpanel": true,
  "markdown.extension.completion.enabled": true,
  "markdown.extension.preview.autoShowPreviewToSide": true,
  "markdown.extension.toc.levels": "2..3",
  "[markdown]": {
    "editor.wordWrap": "on",
  },
  "editor.tabSize": 2,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "TODO",
    "XXX",
    "TODO [JOI-3216]",
    "TODO [JOI-3278]",
    "TODO [JOI-3285]",
    "TODO [JOI-3225]",
    "TODO [JOI-3281]",
    "TODO [JOI-",
    "TODO [MR]"
  ],
  "editor.codeActionsOnSave": {
    "source.removeUnusedImports": "always",
  },
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.mouseWheelZoom": true,
  "totalTypeScript.hiddenTips": [
    "typing-function-parameters",
    "union-type",
    "literal-type",
    "variable-type-annotation",
    "array-type",
    "function-return-type",
    "passing-generics-to-types",
    "basic-types",
    "ts-object-type",
    "optional-object-property",
    "non-null-expression",
    "interface-declaration",
    "keyof",
    "pick-utility-type",
    "undefined-keyword",
    "as-assertion",
    "any-type",
    "tuple-type",
    "type-alias-declaration",
    "null-keyword",
    "in-operator-narrowing",
    "generic-slots-in-functions",
    "typeof",
    "as-const",
    "partial-utility-type",
    "interface-with-generics",
    "interface-with-multiple-generics",
    "type-alias-with-generics",
    "as-const-on-object",
    "readonly-object-property",
    "record-utility-type",
    "returntype-utility-type",
    "awaited-utility-type",
    "type-predicate",
    "omit-utility-type",
    "mapped-type",
    "conditional-type",
    "infer",
    "nested-conditional-type",
    "type-alias-with-multiple-generics",
    "never-keyword",
    "lowercase-utility-type",
  ],
  "totalTypeScript.hideAllTips": false,
  "totalTypeScript.hideBasicTips": false,
  "dynamo.showExplorer": true,
  "explorer.confirmDelete": false,
  "diffEditor.renderSideBySide": true,
  "editor.minimap.renderCharacters": false,
  "workbench.editor.splitInGroupLayout": "vertical",
  "window.confirmBeforeClose": "always",
  "aws.cloudformation.telemetry.enabled": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "haskell.manageHLS": "GHCup",
  "notebook.output.wordWrap": true,
  "claudeCode.useTerminal": true,
  "claudeCode.preferredLocation": "sidebar",
  "workbench.activityBar.location": "top",
  "claudeCode.selectedModel": "default",
  "debug.breakpointsView.presentation": "tree",
  "terminal.integrated.initialHint": false,
  "git.autofetch": true,
  "chat.viewSessions.orientation": "stacked",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontLigatures.enabled": true,
  "workbench.startupEditor": "none",
  "todo-tree.ripgrep.ripgrep": "/Applications/Visual Studio Code.app/Contents/Resources/app/node_modules/@vscode/ripgrep-universal/bin/darwin-arm64/rg",
  "git.detectWorktrees": true,
  "git.confirmSync": false,
  "redhat.telemetry.enabled": false,
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "git.openRepositoryInParentFolders": "never",
  "mochaExplorer.configFile": "",
  "mochaExplorer.envPath": "joiin/.env.deploy",
}
